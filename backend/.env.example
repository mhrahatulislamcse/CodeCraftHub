# ==========================================
# CodeCraftHub Backend - Environment Configuration
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=codecrafthub_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000

# JWT Authentication
JWT_SECRET=super_secret_codecrafthub_jwt_key_change_in_production_32chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_codecrafthub_refresh_key_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# AI Service Configuration (OpenAI or compatible provider)
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o-mini
AI_FALLBACK_ENABLED=true

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
