# =================================================================
# CodeCraftHub Backend - Production Environment Template (.env.production)
# =================================================================

# Server Runtime
PORT=5000
NODE_ENV=production
API_PREFIX=/api/v1

# Frontend Origin for Strict CORS (change to your production domain)
CLIENT_URL=https://codecrafthub.dev

# PostgreSQL Production Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=codecrafthub_db
DB_USER=codecrafthub_app
DB_PASSWORD=ChangeThisSecurePasswordInProduction123!
DB_SSL=false

# Connection Pool Tuning
DB_POOL_MAX=25
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONN_TIMEOUT_MS=5000

# JSON Web Token Cryptographic Secrets (Use openssl rand -hex 32)
JWT_ACCESS_SECRET=replace_with_64_character_hex_string_for_access_token_security
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace_with_64_character_hex_string_for_refresh_token_security
JWT_REFRESH_EXPIRY=7d
PASSWORD_RESET_SECRET=replace_with_64_character_hex_string_for_password_reset_tokens

# API Request Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Optional External AI API Key (Leaves empty to use internal grounded semantic heuristics)
OPENAI_API_KEY=

